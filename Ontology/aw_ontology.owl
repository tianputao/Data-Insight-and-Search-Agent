        <rdfs:comment xml:lang="en">AdventureWorks product category: Derailleurs.</rdfs:comment>
        <rdfs:comment xml:lang="zh">AdventureWorks 产品类目：Derailleurs。</rdfs:comment>
        <rdfs:label xml:lang="en">Derailleurs</rdfs:label>
        <rdfs:label xml:lang="zh">Derailleurs</rdfs:label>
    </owl:Class>
    


    <!-- http://tarhone.com/ontology/adventrueworks#DiscountedOrderLine -->

    <owl:Class rdf:about="http://tarhone.com/ontology/adventrueworks#DiscountedOrderLine">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://tarhone.com/ontology/adventrueworks#SalesOrderLine"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://tarhone.com/ontology/adventrueworks#unitPriceDiscount"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrderLine"/>
        <rdfs:comment xml:lang="zh">:unitPriceDiscount &gt; 0 的折扣明细行。等价类。</rdfs:comment>
        <rdfs:comment xml:lang="en">An order line whose :unitPriceDiscount is &gt; 0. Defined class.</rdfs:comment>
        <rdfs:label xml:lang="en">Discounted Order Line</rdfs:label>
        <rdfs:label xml:lang="zh">折扣明细行</rdfs:label>
    </owl:Class>
    


