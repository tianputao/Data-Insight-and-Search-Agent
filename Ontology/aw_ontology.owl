        <rdfs:comment xml:lang="en">Product weight in grams.</rdfs:comment>
        <rdfs:comment xml:lang="zh">产品重量（克）。</rdfs:comment>
        <rdfs:label xml:lang="en">weight</rdfs:label>
        <rdfs:label xml:lang="zh">重量</rdfs:label>
    </owl:DatatypeProperty>
    


