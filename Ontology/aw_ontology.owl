        <rdfs:comment xml:lang="zh">订单小计金额（美元）。不含税额和运费。</rdfs:comment>
        <rdfs:label xml:lang="en">sub total</rdfs:label>
        <rdfs:label xml:lang="en">order subtotal</rdfs:label>
        <rdfs:label xml:lang="zh">小计</rdfs:label>
        <rdfs:label xml:lang="zh">订单小计</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#taxAmt -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#taxAmt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <unit xml:lang="en">USD</unit>
        <rdfs:comment xml:lang="en">Tax amount in USD.</rdfs:comment>
        <rdfs:comment xml:lang="zh">税额（美元）。</rdfs:comment>
        <rdfs:label xml:lang="en">tax amount</rdfs:label>
        <rdfs:label xml:lang="zh">税额</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#totalDue -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#totalDue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <unit xml:lang="en">USD</unit>
        <rdfs:comment xml:lang="en">Grand total due in USD. Order grain, and it includes tax and freight. Average order value is this amount summed and divided by the distinct order count.</rdfs:comment>
        <rdfs:comment xml:lang="zh">应付总额（美元）。订单粒度，含税额与运费。客单价的官方口径为本金额合计 ÷ 去重订单数，与明细行单价无关。</rdfs:comment>
        <rdfs:label xml:lang="en">total due</rdfs:label>
        <rdfs:label xml:lang="en">order total</rdfs:label>
        <rdfs:label xml:lang="en">average order value</rdfs:label>
        <rdfs:label xml:lang="en">revenue</rdfs:label>
        <rdfs:label xml:lang="en">sales amount</rdfs:label>
        <rdfs:label xml:lang="en">sales value</rdfs:label>
        <rdfs:label xml:lang="en">spending</rdfs:label>
        <rdfs:label xml:lang="zh">应付总额</rdfs:label>
        <rdfs:label xml:lang="zh">订单总额</rdfs:label>
        <rdfs:label xml:lang="zh">客单价</rdfs:label>
        <rdfs:label xml:lang="zh">平均客单价</rdfs:label>
        <rdfs:label xml:lang="zh">销售额</rdfs:label>
        <rdfs:label xml:lang="zh">销售金额</rdfs:label>
        <rdfs:label xml:lang="zh">营收</rdfs:label>
        <rdfs:label xml:lang="zh">消费</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#unitPrice -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#unitPrice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrderLine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <unit xml:lang="en">USD</unit>
        <rdfs:comment xml:lang="en">Unit price in USD, before the line discount.</rdfs:comment>
        <rdfs:comment xml:lang="zh">单价（美元），未扣除明细行折扣。</rdfs:comment>
        <rdfs:label xml:lang="en">unit price</rdfs:label>
        <rdfs:label xml:lang="en">selling price</rdfs:label>
        <rdfs:label xml:lang="zh">单价</rdfs:label>
        <rdfs:label xml:lang="zh">售价</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#unitPriceDiscount -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#unitPriceDiscount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrderLine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Discount fraction (0..1).</rdfs:comment>
        <rdfs:comment xml:lang="zh">折扣比例（0..1）。</rdfs:comment>
        <rdfs:label xml:lang="en">unit price discount</rdfs:label>
        <rdfs:label xml:lang="zh">单价折扣率</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#weight -->

