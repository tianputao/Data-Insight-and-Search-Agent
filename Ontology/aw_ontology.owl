    <!-- http://tarhone.com/ontology/adventrueworks#BusinessCustomer -->

    <owl:Class rdf:about="http://tarhone.com/ontology/adventrueworks#BusinessCustomer">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://tarhone.com/ontology/adventrueworks#Customer"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://tarhone.com/ontology/adventrueworks#companyName"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://tarhone.com/ontology/adventrueworks#Customer"/>
        <owl:disjointWith rdf:resource="http://tarhone.com/ontology/adventrueworks#IndividualCustomer"/>
        <rdfs:comment xml:lang="en">A customer that represents a company. Equivalent to any Customer with a non-empty :companyName value.</rdfs:comment>
        <rdfs:comment xml:lang="zh">代表公司的客户。等价于任何拥有非空 :companyName 的 Customer。</rdfs:comment>
        <rdfs:label xml:lang="en">Business Customer</rdfs:label>
        <rdfs:label xml:lang="zh">企业客户</rdfs:label>
    </owl:Class>
    


