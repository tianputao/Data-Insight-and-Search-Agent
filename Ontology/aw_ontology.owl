<?xml version="1.0"?>
<rdf:RDF xmlns="http://tarhone.com/ontology/adventrueworks#"
     xml:base="http://tarhone.com/ontology/adventrueworks"
     xmlns:aw="http://tarhone.com/ontology/adventrueworks#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://tarhone.com/ontology/adventrueworks">
        <rdfs:comment xml:lang="en">An OWL 2 DL ontology generated from the AdventureWorks Silver layer (ai_data_insight.silver). Includes Customers, Addresses, Sales Orders, Order Lines, Products, and a recursive Product Category hierarchy. Authored as a learning demo for Protégé.</rdfs:comment>
        <rdfs:comment xml:lang="zh">基于 AdventureWorks Silver 数据层（ai_data_insight.silver）自动生成的 OWL 2 DL 本体，包含客户、地址、销售订单、订单明细、产品以及递归产品类目层次结构。用于 Protégé 入门演示。</rdfs:comment>
        <rdfs:label xml:lang="en">AdventureWorks Sales Ontology</rdfs:label>
        <rdfs:label xml:lang="zh">AdventureWorks 销售本体</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://tarhone.com/ontology/adventrueworks#unit -->

    <owl:AnnotationProperty rdf:about="http://tarhone.com/ontology/adventrueworks#unit">
        <rdfs:comment xml:lang="en">Free-text unit-of-measure annotation for data properties.</rdfs:comment>
        <rdfs:label xml:lang="en">unit</rdfs:label>
        <rdfs:label xml:lang="zh">单位</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#dateTime -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#dateTime"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://tarhone.com/ontology/adventrueworks#containsProduct -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#containsProduct">
        <owl:inverseOf rdf:resource="http://tarhone.com/ontology/adventrueworks#inCategory"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#ProductCategory"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#Product"/>
        <rdfs:comment xml:lang="zh">:inCategory 的逆属性。</rdfs:comment>
        <rdfs:comment xml:lang="en">Inverse of :inCategory.</rdfs:comment>
        <rdfs:label xml:lang="en">contains product</rdfs:label>
        <rdfs:label xml:lang="zh">包含产品</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#hasAddressLink -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#hasAddressLink">
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Customer"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#CustomerAddressLink"/>
        <rdfs:comment xml:lang="en">Customer side of the reified n-ary CustomerAddressLink.</rdfs:comment>
        <rdfs:comment xml:lang="zh">实化 n 元关系 CustomerAddressLink 的客户端。</rdfs:comment>
        <rdfs:label xml:lang="en">has address link</rdfs:label>
        <rdfs:label xml:lang="zh">拥有地址关联</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#hasBillToAddress -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#hasBillToAddress">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#Address"/>
        <rdfs:comment xml:lang="en">The billing address of a Sales Order.</rdfs:comment>
        <rdfs:comment xml:lang="zh">销售订单的账单地址。</rdfs:comment>
        <rdfs:label xml:lang="en">has bill-to address</rdfs:label>
        <rdfs:label xml:lang="zh">账单地址</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#hasColor -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#hasColor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Product"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#ProductColor"/>
        <rdfs:comment xml:lang="en">Color of a Product.</rdfs:comment>
        <rdfs:comment xml:lang="zh">产品的颜色。</rdfs:comment>
        <rdfs:label xml:lang="en">has color</rdfs:label>
        <rdfs:label xml:lang="zh">颜色</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#hasOrderLine -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#hasOrderLine">
        <owl:inverseOf rdf:resource="http://tarhone.com/ontology/adventrueworks#partOfOrder"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrderLine"/>
        <rdfs:comment xml:lang="en">Links a Sales Order to one of its order lines.</rdfs:comment>
        <rdfs:comment xml:lang="zh">将销售订单与其某条明细行关联。</rdfs:comment>
        <rdfs:label xml:lang="en">has order line</rdfs:label>
        <rdfs:label xml:lang="zh">包含明细行</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#hasParentCategory -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#hasParentCategory">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#ProductCategory"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#ProductCategory"/>
        <rdfs:comment xml:lang="en">The immediate parent in the ProductCategory hierarchy.</rdfs:comment>
        <rdfs:comment xml:lang="zh">产品类目层次的直接父节点。</rdfs:comment>
        <rdfs:label xml:lang="en">has parent category</rdfs:label>
        <rdfs:label xml:lang="zh">父类目</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#hasShipMethod -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#hasShipMethod">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#ShipMethod"/>
        <rdfs:comment xml:lang="en">Shipping method used for this Sales Order.</rdfs:comment>
        <rdfs:comment xml:lang="zh">此销售订单使用的运输方式。</rdfs:comment>
        <rdfs:label xml:lang="en">has ship method</rdfs:label>
        <rdfs:label xml:lang="zh">运输方式</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#hasShipToAddress -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#hasShipToAddress">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#Address"/>
        <rdfs:comment xml:lang="en">The shipping address of a Sales Order.</rdfs:comment>
        <rdfs:comment xml:lang="zh">销售订单的收货地址。</rdfs:comment>
        <rdfs:label xml:lang="en">has ship-to address</rdfs:label>
        <rdfs:label xml:lang="zh">收货地址</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#hasStatus -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#hasStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#OrderStatus"/>
        <rdfs:comment xml:lang="en">OrderStatus of this Sales Order.</rdfs:comment>
        <rdfs:comment xml:lang="zh">此销售订单的状态。</rdfs:comment>
        <rdfs:label xml:lang="en">has status</rdfs:label>
        <rdfs:label xml:lang="zh">订单状态</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#hasTitle -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#hasTitle">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Customer"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#PersonTitle"/>
        <rdfs:comment xml:lang="en">Personal title for a Customer.</rdfs:comment>
        <rdfs:comment xml:lang="zh">客户的称谓。</rdfs:comment>
        <rdfs:label xml:lang="en">has title</rdfs:label>
        <rdfs:label xml:lang="zh">称谓</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#inCategory -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#inCategory">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Product"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#ProductCategory"/>
        <rdfs:comment xml:lang="en">Direct ProductCategory of this product.</rdfs:comment>
        <rdfs:comment xml:lang="zh">此产品所属的（最细粒度）产品类目。</rdfs:comment>
        <rdfs:label xml:lang="en">in category</rdfs:label>
        <rdfs:label xml:lang="zh">属于类目</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#linksAddress -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#linksAddress">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#CustomerAddressLink"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#Address"/>
        <rdfs:comment xml:lang="en">Address side of the reified CustomerAddressLink.</rdfs:comment>
        <rdfs:comment xml:lang="zh">实化关系 CustomerAddressLink 的地址端。</rdfs:comment>
        <rdfs:label xml:lang="en">links address</rdfs:label>
        <rdfs:label xml:lang="zh">关联地址</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#linksAddressType -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#linksAddressType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#CustomerAddressLink"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#AddressType"/>
        <rdfs:comment xml:lang="en">AddressType side of the reified CustomerAddressLink.</rdfs:comment>
        <rdfs:comment xml:lang="zh">实化关系 CustomerAddressLink 的地址类型端。</rdfs:comment>
        <rdfs:label xml:lang="en">links address type</rdfs:label>
        <rdfs:label xml:lang="zh">关联地址类型</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#partOfOrder -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#partOfOrder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrderLine"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:comment xml:lang="zh">:hasOrderLine 的逆属性。</rdfs:comment>
        <rdfs:comment xml:lang="en">Inverse of :hasOrderLine.</rdfs:comment>
        <rdfs:label xml:lang="en">part of order</rdfs:label>
        <rdfs:label xml:lang="zh">属于订单</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#placedBy -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#placedBy">
        <owl:inverseOf rdf:resource="http://tarhone.com/ontology/adventrueworks#placedOrder"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#Customer"/>
        <rdfs:comment xml:lang="en">The Customer who placed this Sales Order.</rdfs:comment>
        <rdfs:comment xml:lang="zh">下此销售订单的客户。</rdfs:comment>
        <rdfs:label xml:lang="en">placed by</rdfs:label>
        <rdfs:label xml:lang="zh">下单人</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#placedOrder -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#placedOrder">
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Customer"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:comment xml:lang="zh">:placedBy 的逆属性；客户下的订单。</rdfs:comment>
        <rdfs:comment xml:lang="en">Inverse of :placedBy; orders placed by the customer.</rdfs:comment>
        <rdfs:label xml:lang="en">placed order</rdfs:label>
        <rdfs:label xml:lang="zh">下单</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#refersToProduct -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#refersToProduct">
        <owl:inverseOf rdf:resource="http://tarhone.com/ontology/adventrueworks#soldIn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrderLine"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#Product"/>
        <rdfs:comment xml:lang="en">The Product referenced by this order line.</rdfs:comment>
        <rdfs:comment xml:lang="zh">此明细行所引用的产品。</rdfs:comment>
        <rdfs:label xml:lang="en">refers to product</rdfs:label>
        <rdfs:label xml:lang="zh">引用产品</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#soldIn -->

    <owl:ObjectProperty rdf:about="http://tarhone.com/ontology/adventrueworks#soldIn">
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Product"/>
        <rdfs:range rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrderLine"/>
        <rdfs:comment xml:lang="en">Order lines that reference this product.</rdfs:comment>
        <rdfs:comment xml:lang="zh">引用此产品的订单明细。</rdfs:comment>
        <rdfs:label xml:lang="en">sold in</rdfs:label>
        <rdfs:label xml:lang="zh">出售于</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://tarhone.com/ontology/adventrueworks#accountNumber -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#accountNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#SalesOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Customer account number.</rdfs:comment>
        <rdfs:comment xml:lang="zh">客户账户号。</rdfs:comment>
        <rdfs:label xml:lang="en">account number</rdfs:label>
        <rdfs:label xml:lang="zh">账户号</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#addressId -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#addressId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="zh">AdventureWorks 原始 AddressID。</rdfs:comment>
        <rdfs:comment xml:lang="en">Original AdventureWorks AddressID.</rdfs:comment>
        <rdfs:label xml:lang="en">address id</rdfs:label>
        <rdfs:label xml:lang="zh">地址编号</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#addressLine1 -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#addressLine1">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Street address line 1.</rdfs:comment>
        <rdfs:comment xml:lang="zh">街道地址第一行。</rdfs:comment>
        <rdfs:label xml:lang="en">address line 1</rdfs:label>
        <rdfs:label xml:lang="zh">地址行1</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#addressLine2 -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#addressLine2">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Street address line 2 (suite/apt).</rdfs:comment>
        <rdfs:comment xml:lang="zh">街道地址第二行（套房/单元）。</rdfs:comment>
        <rdfs:label xml:lang="en">address line 2</rdfs:label>
        <rdfs:label xml:lang="zh">地址行2</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#categoryId -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#categoryId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#ProductCategory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Original AdventureWorks ProductCategoryID.</rdfs:comment>
        <rdfs:comment xml:lang="zh">原始 ProductCategoryID。</rdfs:comment>
        <rdfs:label xml:lang="en">category id</rdfs:label>
        <rdfs:label xml:lang="zh">类目编号</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#categoryName -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#categoryName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#ProductCategory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Display name of the category.</rdfs:comment>
        <rdfs:comment xml:lang="zh">类目显示名。</rdfs:comment>
        <rdfs:label xml:lang="en">category name</rdfs:label>
        <rdfs:label xml:lang="zh">类目名</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#city -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#city">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">City name.</rdfs:comment>
        <rdfs:comment xml:lang="zh">城市名。</rdfs:comment>
        <rdfs:label xml:lang="en">city</rdfs:label>
        <rdfs:label xml:lang="zh">城市</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#clothingSize -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#clothingSize">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Clothing size code (S, M, L, XL).</rdfs:comment>
        <rdfs:comment xml:lang="zh">服装尺寸编码（S/M/L/XL）。</rdfs:comment>
        <rdfs:label xml:lang="en">clothing size</rdfs:label>
        <rdfs:label xml:lang="zh">服装尺寸</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://tarhone.com/ontology/adventrueworks#companyName -->

    <owl:DatatypeProperty rdf:about="http://tarhone.com/ontology/adventrueworks#companyName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://tarhone.com/ontology/adventrueworks#Customer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Company name (B2B customers).</rdfs:comment>
        <rdfs:comment xml:lang="zh">公司名（B2B 客户）。</rdfs:comment>
        <rdfs:label xml:lang="en">company name</rdfs:label>
        <rdfs:label xml:lang="zh">公司名</rdfs:label>
    </owl:DatatypeProperty>
    


